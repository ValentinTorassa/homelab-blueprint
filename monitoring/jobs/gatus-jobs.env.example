# ~/.config/homelab/gatus-jobs.env on the server, mode 0600, never in git.
# Read by report-job.sh. One token per external endpoint; the same value goes
# into the monitor's environment so Gatus can expand ${GATUS_TOKEN_...}.
#
# Generate each one with: openssl rand -hex 32

GATUS_BASE_URL=https://status.home.example.internal

GATUS_TOKEN_SERVER_HEALTH=change-me
GATUS_TOKEN_BACKUP_APP_A=change-me
GATUS_TOKEN_BACKUP_BLOG=change-me
GATUS_TOKEN_BACKUP_MAILER=change-me
GATUS_TOKEN_BACKUP_OFFSITE_S3=change-me
GATUS_TOKEN_RESTORE_TEST=change-me
GATUS_TOKEN_CONFIG_DRIFT=change-me

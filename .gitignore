__pycache__/
*.pyc
.pytest_cache/
# Never commit real configuration or keys made from the examples.
*.env
!*.env.example
*.pem
*.token
gatus-jobs.env
# Terraform: provider downloads, state, plans and real values stay out of git.
# The dependency lock file (.terraform.lock.hcl) IS committed.
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example
